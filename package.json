{
  "name": "oc-mm-client",
  "version": "1.0.0",
  "description": "Mattermost client plugin for opencode",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chi-teck/oc-mm-client.git"
  },
  "engines": {
    "bun": ">=1.0.0",
    "opencode": ">=2.0.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "oc-mm": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mattermost"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@opencode/plugin": "2.0.14",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mattermost/client": "11.9.0",
    "@mattermost/types": "11.9.0",
    "zod": "^4.2.0"
  }
}
